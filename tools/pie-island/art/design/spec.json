    "deform": {
      "order": [
        "scale",
        "faceFlatten",
        "forehead",
        "foreheadNarrow",
        "cheek",
        "chin",
        "occiput"
      ],
      "faceFlatten": "For every vertex with z>0: z = z * 0.62 + 0.05. Do this on the cheeks too. A threshold such as z>0.13 only flattens the nose tip and leaves a ball.",
      "forehead": "If y>0.06 and z>0: z -= 0.025 * smoothstep(0.06, 0.16, y). The high camera then still sees the eyes.",
      "cheek": {
        "centers": [
          [
            0.12,
            -0.02,
            0.06
          ],
          [
            -0.12,
            -0.02,
            0.06
          ]
        ],
        "sigma": 0.07,
        "push": "Move along +X or -X (away from the midline) by cheekPush * gaussian."
      },
      "chin": "If y< -0.10: narrow x toward 0 by chinNarrow, y -= chinDrop * smoothstep, z += 0.02 * smoothstep.",
      "occiput": "If z<0 and y<0.06: z -= 0.035, y -= 0.02. Round bun base, not a second ball glued on.",
      "foreheadNarrow": "If y>0.04: x *= 1 - foreheadNarrow * smoothstep(0.04, 0.20, y). Apple 0.24, round 0.10, melon 0.30. This is the difference between an apple and a sphere."
